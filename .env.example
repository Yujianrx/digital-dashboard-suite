# Node: copy to .env and use npm run start:web (Node loads .env).
# Docker Compose also reads .env. Do not commit your actual configuration.
DASHBOARD_PUBLIC_ORIGIN=https://dashboard.example.com
DASHBOARD_ADMIN_USER=admin
# Set your own password (at least 12 characters); no default password is bundled.
DASHBOARD_ADMIN_PASSWORD=
# Optional: DASHBOARD_DATA_DIR, DASHBOARD_BACKUP_DIR, PORT (default 8765).
# Local-only readonly operations API is disabled unless explicitly configured.
# DASHBOARD_OPERATIONS_API=http://127.0.0.1:18787
