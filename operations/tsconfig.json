{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/main.ts",
    "src/App.vue",
    "src/restaurant/**/*",
    "src/views/index/index.vue",
    "src/views/index/center-map.vue",
    "src/views/index/center.map.ts",
    "src/views/index/map3d/**/*",
    "src/components/datav/border-box-13/**/*",
    "src/plugins/echarts.ts"
  ]
}
