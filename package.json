{
  "name": "digital-dashboard-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多平台会员运营数据看板，集中管理小程序、视频号、小红书、抖音视频与公众号的运营指标和活动数据，支持会员储值、活动排期与效果复盘，可本地、网站或纯静态部署。",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed:template": "node scripts/create-initial-state.mjs",
    "start": "node server/host.mjs",
    "build": "node scripts/build-operations.mjs",
    "setup:operations": "npm --prefix operations ci --ignore-scripts",
    "test": "node --test tests/*.test.mjs",
    "test:operations": "npm --prefix operations test",
    "check:public": "node scripts/check-public.mjs",
    "start:web": "node --env-file=.env server/start-web.mjs",
    "start:legacy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File server/dashboard-host.ps1 -LoopbackOnly",
    "build:static": "node scripts/build-static.mjs",
    "test:artifact": "node --test tests/artifacts/static.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yujianrx/digital-dashboard-suite.git"
  },
  "homepage": "https://github.com/Yujianrx/digital-dashboard-suite#readme",
  "keywords": [
    "multi-platform",
    "member-operations",
    "membership-analytics",
    "marketing-analytics",
    "campaign-management",
    "wechat-mini-program",
    "wechat-channels",
    "xiaohongshu",
    "douyin",
    "wechat-official-account",
    "dashboard",
    "data-visualization",
    "self-hosted",
    "vue3",
    "typescript",
    "nodejs",
    "sqlite",
    "docker",
    "github-pages"
  ]
}
