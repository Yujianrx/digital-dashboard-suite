{
  "name": "digital-dashboard-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "通用数据看板套件：会员运营、活动计划、营业统计和连锁经营大屏；无品牌及真实业务数据。",
  "engines": {"node": ">=22.13"},
  "scripts": {
    "seed:template": "node scripts/create-initial-state.mjs",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File server/dashboard-host.ps1 -LoopbackOnly",
    "build": "node scripts/build-operations.mjs",
    "setup:operations": "npm --prefix operations ci --ignore-scripts",
    "test": "node --test tests/*.test.mjs",
    "test:operations": "npm --prefix operations test",
    "check:public": "node scripts/check-public.mjs"
  },
  "repository": {"type":"git","url":"https://github.com/zhujiaowo-sudo/-.git"}
}
